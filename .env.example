# ===== 环境变量配置示例 =====
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=          # MySQL root密码（开发环境可设为 rag123456）
MYSQL_DATABASE=rag_kb        # 数据库名

# ===== MinIO（文档存储） =====
MINIO_ROOT_USER=             # MinIO管理员用户名（默认 minioadmin）
MINIO_ROOT_PASSWORD=         # MinIO管理员密码（默认 minioadmin）

# ===== Milvus 内部 MinIO =====
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin

# ===== 大模型 API =====
DEEPSEEK_API_KEY=            # DeepSeek API密钥（https://platform.deepseek.com 注册获取）
ZHIPU_API_KEY=               # 智谱API密钥（https://open.bigmodel.cn 注册获取）
